# Linacre Wallpaper Backend Configuration
# Copy to .env and adjust as needed

# Server
HOST=127.0.0.1
PORT=8765

# Update intervals (seconds)
WS_INTERVAL=1.5
GPU_INTERVAL=2.0
DOCKER_INTERVAL=3.0

# GPU Monitoring
GPU_ENABLED=true
GPU_BACKEND=auto  # auto, nvidia, amd, intel

# Docker Monitoring
DOCKER_ENABLED=true
# Windows Docker Desktop uses named pipe:
DOCKER_SOCKET=npipe:////./pipe/docker_engine
# Linux/WSL2:
# DOCKER_SOCKET=unix:///var/run/docker.sock

# Custom services to monitor (JSON object: name -> [process patterns])
# Example matches your projects:
CUSTOM_SERVICES='{"GhostMail": ["ghostmail", "smtp"], "DomainDeals": ["domaindeals", "next-server"], "linacre.site": ["linacre", "vite", "node"], "PostgreSQL": ["postgres"], "Redis": ["redis-server"], "Ollama": ["ollama"]}'

# Top processes
TOP_PROCESS_COUNT=12

# Network interfaces to monitor (empty = all)
# NETWORK_INTERFACES=eth0,wlan0

# Disk mounts to monitor (empty = all)
# DISK_MOUNTS=/,/home,/mnt/data